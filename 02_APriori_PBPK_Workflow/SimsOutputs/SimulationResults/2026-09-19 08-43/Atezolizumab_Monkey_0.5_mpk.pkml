                      <Parameter id="1ebf_q_1QUuufbzGrhLqag" name="Immediately dissolve particles smaller than" description="Threshold for the particle radius of immediate dissolution" icon="Parameter" persistable="0" isFixedValue="0" dim="Length" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="1E-07" displayUnit="µm">
