                      <Parameter id="kSZDzPfJB0Oc_Ni0VUe0FQ" name="Kd (FcRn) in endosomal space" description="Dissociation constant of drug for binding to FcRn in endosomal space" icon="Parameter" persistable="0" isFixedValue="0" dim="Concentration (molar)" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="0" value="0.65" displayUnit="µmol/l">
