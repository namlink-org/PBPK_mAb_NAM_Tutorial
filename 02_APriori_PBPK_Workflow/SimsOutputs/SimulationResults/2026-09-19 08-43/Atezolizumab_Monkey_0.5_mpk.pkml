                      <Parameter id="fMpHmh210kSxtCn0wQgDuw" name="Aqueous diffusion coefficient" description="Aqueous diffusion coefficient&#xA;of the drug" icon="Parameter" persistable="0" isFixedValue="0" dim="Diffusion coefficient" quantityType="Parameter" negativeValuesAllowed="1" formula="Ghea-QhD7UiEmpLCJp1zdw" buildMode="Global" isDefault="1" displayUnit="cm²/min">
