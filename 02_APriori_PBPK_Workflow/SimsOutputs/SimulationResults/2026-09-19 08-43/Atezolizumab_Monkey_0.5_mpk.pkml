                        <Info min="0" flag="52" seq="1" ref="0" bb="2" group="63" />
                      </Parameter>
                      <Parameter id="D286-x3N1kWk_fn7aiD9zg" name="Lipophilicity" description="Model dependent lipophilicity measure: LogMA / LogP / ..." icon="Parameter" persistable="0" isFixedValue="0" dim="Log Units" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="0" value="-5" displayUnit="Log Units">
                        <Info min="-10" max="10" flag="58" seq="2" ref="0" bb="4" group="12" />
                      </Parameter>
                      <Parameter id="NSZItjEPGUKkl9PhCSDt1g" name="Fraction unbound (plasma, reference value)" description="Fraction unbound in plasma of the reference individual, i.e. in the case of human typically an average healthy adult. This reference value can be scaled to children based on the ontogeny of the respective plasma protein and/or in diseased subjects using the plasma protein scale factor defined in the individual" icon="Parameter" persistable="0" isFixedValue="0" dim="Fraction" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="0" value="1">
                        <Info min="0" max="1" flag="106" seq="3" ref="0" bb="4" group="10" />
                      </Parameter>
